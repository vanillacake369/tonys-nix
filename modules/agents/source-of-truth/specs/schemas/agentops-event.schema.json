{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tonys-nix.local/agent-specs/agentops-event.schema.json",
  "title": "AgentOps Event",
  "type": "object",
  "required": ["schemaVersion", "event_id", "run_id", "timestamp", "event_type", "provider", "content_capture"],
  "properties": {
    "schemaVersion": { "const": "agentops.event.v1" },
    "event_id": { "type": "string" },
    "run_id": { "type": "string" },
    "trace_id": { "type": ["string", "null"] },
    "span_id": { "type": ["string", "null"] },
    "parent_span_id": { "type": ["string", "null"] },
    "timestamp": { "type": "string" },
    "event_type": { "type": "string" },
    "provider": { "type": "string" },
    "surface": { "type": ["string", "null"] },
    "workflow": { "type": ["string", "null"] },
    "risk_level": { "type": ["string", "null"] },
    "operation_id": { "type": ["string", "null"] },
    "tool_name": { "type": ["string", "null"] },
    "success": { "type": ["boolean", "null"] },
    "error_type": { "type": ["string", "null"] },
    "artifact_path": { "type": ["string", "null"] },
    "artifact_hash": { "type": ["string", "null"] },
    "content_capture": { "type": "boolean" },
    "approval_required": { "type": ["boolean", "null"] },
    "approval_granted": { "type": ["boolean", "null"] },
    "approval_source": { "type": ["string", "null"] },
    "sandbox_mode": { "type": ["string", "null"] },
    "policy_source": { "type": ["string", "null"] },
    "hook_version": { "type": ["string", "null"] },
    "context_source_id": { "type": ["string", "null"] },
    "context_path": { "type": ["string", "null"] },
    "context_tokens_estimated": { "type": ["integer", "null"], "minimum": 0 },
    "trust_label": { "type": ["string", "null"] },
    "waiver_reason": { "type": ["string", "null"] }
  },
  "additionalProperties": true
}
