#!/usr/bin/env bash
# Unified Zellij picker for commands, sessions, tabs, and panes.
#
# Responsibilities:
# - build a readable fzf candidate list
# - show a lightweight live preview of the selected pane
# - dispatch the selected command or navigation target
# - record exactly one return target for navigation: previous-target.json
#
# Preview strategy:
# - render one frame immediately
# - wait briefly before starting live polling
# - poll at a conservative interval
# - redraw only when the pane frame actually changes
# - let fzf own preview-process cancellation
#
# State flow:
# - command selections normally do not modify navigation state
# - opening the built-in session-manager records the current target first,
#   because the later session switch happens inside the plugin and cannot call
#   back into this script
# - session/tab/pane selections are transactional:
#     capture current -> validate selected target -> focus selected target
#     -> commit captured current as previous-target only after success
# - `zellij-context-toggle` later uses previous-target to return
#
# Failure handling:
# - invalid or stale previous state is cleaned by the shared library
# - picker cancellation is a no-op
# - command/action failures are logged
# - failed picker navigation never overwrites previous-target
# - preview failures do not terminate the picker
# - temporary preview files are removed when fzf terminates the preview process
# - if movement succeeds but previous-target commit fails, the UI remains at
#   the selected target and the old history is preserved
#
# Assumptions:
# - pane and tab candidates are scoped to the current session
# - session candidates include active sessions only, never resurrectable EXITED sessions
# - native `Alt \`` remains responsible for simple previous-pane focus

set -euo pipefail

command -v zellij >/dev/null 2>&1 || exit 127
command -v jq >/dev/null 2>&1 || exit 127
command -v fzf >/dev/null 2>&1 || exit 127
command -v cmp >/dev/null 2>&1 || exit 127
command -v mktemp >/dev/null 2>&1 || exit 127

script_dir="$(cd "$(dirname "$0")" && pwd -P)"
# shellcheck source=/dev/null
. "$script_dir/zellij-nav-lib"

nav_init

mode="${1:---all}"

readonly DEFAULT_PREVIEW_INTERVAL="0.75"
readonly DEFAULT_PREVIEW_LIVE_DELAY="0.40"

is_helper="${ZELLIJ_NAV_HELPER:-0}"
helper_session="$(nav_current_session || true)"
close_helper_pane_on_exit() {
  nav_close_pane_by_id "$helper_session" "${ZELLIJ_PANE_ID:-}" || true
}

if [ "$mode" = "--session-manager" ]; then
  [ "$is_helper" = "1" ] && trap close_helper_pane_on_exit EXIT
  nav_record_current_for_external_navigation "session-manager"
  zellij action launch-or-focus-plugin --floating --move-to-focused-tab "zellij:session-manager"
  exit 0
fi

preview_header() {
  local kind session tab_id pane_id columns
  kind="${1:-unknown}"
  session="${2:--}"
  tab_id="${3:--}"
  pane_id="${4:--}"
  columns="${FZF_PREVIEW_COLUMNS:-80}"

  printf '\033[2m'
  printf 'type=%s  session=%s  tab=%s  pane=%s\n' "$kind" "$session" "$tab_id" "$pane_id"
  printf '\033[0m'
  printf '%*s\n' "$columns" '' | tr ' ' '-'
}

resolve_tab_preview_pane() {
  local session tab_id
  session="$1"
  tab_id="$2"

  zellij --session "$session" action list-panes --json --all --tab --state --command 2>/dev/null |
    jq -r --arg tab_id "$tab_id" '
      [
        .[]
        | select((.tab_id | tostring) == $tab_id)
        | select(.is_selectable == true)
        | select(.is_plugin == false)
        | select(.exited == false)
      ]
      | (map(select(.is_focused == true))[0] // .[0])
      | if . == null then empty else (.id | tostring) end
    ' 2>/dev/null
}

resolve_session_preview_pane() {
  local session
  session="$1"

  zellij --session "$session" action list-panes --json --all --tab --state --command 2>/dev/null |
    jq -r '
      [
        .[]
        | select(.is_selectable == true)
        | select(.is_plugin == false)
        | select(.exited == false)
      ]
      | (map(select(.is_focused == true))[0] // .[0])
      | if . == null then empty else (.id | tostring) end
    ' 2>/dev/null
}

resolve_preview_pane() {
  local kind session tab_id pane_id
  kind="$1"
  session="$2"
  tab_id="$3"
  pane_id="$4"

  case "$kind" in
    pane) printf '%s\n' "$pane_id" ;;
    tab) resolve_tab_preview_pane "$session" "$tab_id" || true ;;
    session) resolve_session_preview_pane "$session" || true ;;
    *) return 1 ;;
  esac
}

capture_preview_frame() {
  local session pane_id output_file
  session="$1"
  pane_id="$2"
  output_file="$3"

  : >"$output_file"
  zellij --session "$session" action dump-screen --pane-id "$pane_id" --ansi >"$output_file" 2>/dev/null
}

draw_preview_file() {
  local kind session tab_id pane_id frame_file
  kind="$1"
  session="$2"
  tab_id="$3"
  pane_id="$4"
  frame_file="$5"

  printf '\033[H\033[2J'
  preview_header "$kind" "$session" "$tab_id" "$pane_id"
  cat "$frame_file"
}

render_command_preview() {
  local command_id label
  command_id="${1:--}"
  label="${2:-Command}"

  printf '\033[H\033[2J'
  printf '\033[1m%s\033[0m\n\n' "$label"
  printf 'Action ID: %s\n\n' "$command_id"
  printf 'Press Enter to execute this Zellij action.\n'
}

render_preview_error() {
  local message
  message="$1"

  printf '\033[H\033[2J'
  printf '\033[1mPreview unavailable\033[0m\n\n'
  printf '%s\n' "$message"
}

render_preview() {
  local kind session tab_id pane_id interval live_delay
  local previous_file current_file
  kind="${1:-}"
  session="${2:-}"
  tab_id="${3:-}"
  pane_id="${4:-}"
  interval="${ZELLIJ_PICKER_PREVIEW_INTERVAL:-$DEFAULT_PREVIEW_INTERVAL}"
  live_delay="${ZELLIJ_PICKER_PREVIEW_LIVE_DELAY:-$DEFAULT_PREVIEW_LIVE_DELAY}"

  case "$kind" in
    command)
      render_command_preview "${5:--}" "${6:-Command}"
      return 0
      ;;
    pane | tab | session)
      ;;
    *)
      render_preview_error "Unsupported candidate type: ${kind:-unknown}"
      return 0
      ;;
  esac

  if [ -z "$session" ] || [ "$session" = "-" ]; then
    render_preview_error "No session is associated with this candidate."
    return 0
  fi

  pane_id="$(resolve_preview_pane "$kind" "$session" "$tab_id" "$pane_id" || true)"

  if [ -z "$pane_id" ] || [ "$pane_id" = "-" ]; then
    render_preview_error "No selectable terminal pane was found."
    return 0
  fi

  previous_file="$(mktemp "${TMPDIR:-/tmp}/zellij-picker-preview.previous.XXXXXX")"
  current_file="$(mktemp "${TMPDIR:-/tmp}/zellij-picker-preview.current.XXXXXX")"

  # fzf terminates the old preview process whenever selection changes.
  trap 'rm -f "$previous_file" "$current_file"' EXIT
  trap 'rm -f "$previous_file" "$current_file"; exit 0' HUP INT TERM

  if ! capture_preview_frame "$session" "$pane_id" "$current_file"; then
    render_preview_error "Unable to capture pane ${pane_id} from session ${session}."
    return 0
  fi

  draw_preview_file "$kind" "$session" "$tab_id" "$pane_id" "$current_file"
  cp "$current_file" "$previous_file"

  # Avoid starting a live loop while the user is quickly moving through rows.
  sleep "$live_delay"

  while :; do
    if ! capture_preview_frame "$session" "$pane_id" "$current_file"; then
      render_preview_error "Pane ${pane_id} is no longer available in session ${session}."
      return 0
    fi

    if ! cmp -s "$previous_file" "$current_file"; then
      draw_preview_file "$kind" "$session" "$tab_id" "$pane_id" "$current_file"
      cp "$current_file" "$previous_file"
    fi

    sleep "$interval"
  done
}

if [ "$mode" = "--render-preview" ]; then
  shift
  render_preview "$@"
  exit 0
fi

[ "$is_helper" = "1" ] && trap close_helper_pane_on_exit EXIT

commands() {
  cat <<'EOF'
[CMD] New pane	command	-	-	-	new-pane	Pane	New pane	-	-
[CMD] New pane right	command	-	-	-	new-pane-right	Pane	New pane right	-	-
[CMD] New pane down	command	-	-	-	new-pane-down	Pane	New pane down	-	-
[CMD] Toggle fullscreen	command	-	-	-	toggle-fullscreen	Pane	Toggle fullscreen	-	-
[CMD] Toggle floating panes	command	-	-	-	toggle-floating-panes	Pane	Toggle floating panes	-	-
[CMD] Previous swap layout	command	-	-	-	previous-swap-layout	Layout	Previous swap layout	-	-
[CMD] Next swap layout	command	-	-	-	next-swap-layout	Layout	Next swap layout	-	-
[CMD] Session manager	command	-	-	-	session-manager	Session	Session manager	-	-
[CMD] Lock	command	-	-	-	lock	System	Lock	-	-
[CMD] Detach	command	-	-	-	detach	System	Detach	-	-
EOF
}

sessions() {
  local current
  current="$(nav_current_session)"
  nav_active_sessions |
    awk -v current="$current" '
      NF {
        suffix = ($1 == current) ? " *" : ""
        display = "[SESSION] " $1 suffix
        printf "%s\tsession\t%s\t-\t-\t-\t%s\t%s\t-\t-\n", display, $1, $1, $1
      }'
}

tabs() {
  local session
  session="$(nav_current_session)"
  zellij action list-tabs --json |
    jq -r --arg session "$session" '
      .[]
      | .name as $name
      | [
          ("[TAB] " + $name),
          "tab",
          $session,
          (.tab_id | tostring),
          "-",
          "-",
          $name,
          $name,
          "-",
          "-"
        ]
      | @tsv'
}

panes() {
  local session current_pane
  session="$(nav_current_session)"
  current_pane="${ZELLIJ_PANE_ID:-}"
  zellij action list-panes --json --all --tab --state --command |
    jq -r --arg session "$session" --arg current_pane "$current_pane" '
      def text($v): if ($v // "") == "" then "-" else ($v | tostring) end;
      def normalize_pane_id: tostring | sub("^terminal_"; "");
      .[]
      | select(.is_selectable == true)
      | select(.is_plugin == false)
      | select(.exited == false)
      | select(
          ($current_pane == "")
          or ((.id | normalize_pane_id) != ($current_pane | normalize_pane_id))
        )
      | (.tab_name // ("Tab " + (.tab_id | tostring))) as $tab
      | text(.title // .pane_command // .terminal_command // .pane_cwd) as $title
      | text(.pane_command // .terminal_command) as $command
      | text(.pane_cwd) as $cwd
      | [
          ("[PANE] " + $tab + " / " + $title),
          "pane",
          $session,
          (.tab_id | tostring),
          (.id | tostring),
          "-",
          $tab,
          $title,
          $command,
          $cwd
        ]
      | @tsv'
}

candidates_for_mode() {
  case "$mode" in
    --commands) commands ;;
    --sessions) sessions ;;
    --tabs) tabs ;;
    --panes) panes ;;
    *)
      commands
      sessions
      tabs
      panes
      ;;
  esac
}

select_candidate() {
  local preview_command
  printf -v preview_command '%q --render-preview {2} {3} {4} {5} {6} {8}' "$0"

  candidates_for_mode |
    fzf --prompt='zellij> ' \
      --delimiter="$(printf '\t')" \
      --with-nth=1 \
      --preview="$preview_command" \
      --preview-window='right,65%,border-left,noinfo' \
      --bind='focus:refresh-preview,ctrl-/:toggle-preview' \
      --header='Enter: open  Ctrl-/: preview  Esc: cancel'
}

field() {
  local line index
  line="$1"
  index="$2"
  printf '%s' "$line" | awk -v index="$index" 'BEGIN { FS = "\t" } { print $index }'
}

target_from_selection() {
  local selection kind session tab_id pane_id label
  selection="$1"
  kind="$(field "$selection" 2)"
  session="$(field "$selection" 3)"
  tab_id="$(field "$selection" 4)"
  pane_id="$(field "$selection" 5)"
  label="$(field "$selection" 1)"
  nav_make_target "$kind" "$session" "$tab_id" "$pane_id" "$label"
}

run_command() {
  local command_id
  command_id="$1"

  case "$command_id" in
    new-pane) zellij action new-pane ;;
    new-pane-right) zellij action new-pane --direction right ;;
    new-pane-down) zellij action new-pane --direction down ;;
    toggle-fullscreen) zellij action toggle-fullscreen ;;
    toggle-floating-panes) zellij action toggle-floating-panes ;;
    previous-swap-layout) zellij action previous-swap-layout ;;
    next-swap-layout) zellij action next-swap-layout ;;
    session-manager)
      nav_record_current_for_external_navigation "session-manager"
      zellij action launch-or-focus-plugin --floating --move-to-focused-tab "zellij:session-manager"
      ;;
    lock) zellij action switch-mode locked ;;
    detach) zellij action detach ;;
    *)
      nav_log "unknown command command_id=$command_id"
      return 1
      ;;
  esac
}

selection="$(select_candidate || true)"
[ -n "$selection" ] || {
  nav_log "picker cancelled mode=$mode"
  exit 0
}

kind="$(field "$selection" 2)"
command_id="$(field "$selection" 6)"

if [ "$kind" = "command" ]; then
  if run_command "$command_id"; then
    nav_log "command executed command_id=$command_id"
  else
    nav_log "command failed command_id=$command_id"
  fi
  exit 0
fi

selected_target="$(target_from_selection "$selection")"
if [ "$is_helper" = "1" ] && [ -n "${ZELLIJ_PANE_ID:-}" ]; then
  nav_defer_navigation_to_target "$selected_target" || {
    nav_log "picker navigation failed reason=defer-failed target=$(nav_target_summary "$selected_target")"
    exit 1
  }
  exit 0
fi

navigation_status=0
nav_navigate_to_target "$selected_target" || navigation_status=$?

case "$navigation_status" in
  0) nav_log "picker navigation completed target=$(nav_target_summary "$selected_target")" ;;
  3) nav_log "picker navigation no-op target=$(nav_target_summary "$selected_target")" ;;
  4) nav_log "picker navigation partial status=history-commit-failed moved_to=$(nav_target_summary "$selected_target") previous_history_preserved=true" ;;
  *) nav_log "picker navigation failed status=$navigation_status target=$(nav_target_summary "$selected_target")" ;;
esac
