#!/usr/bin/env bash
set -euo pipefail

script_dir="$(cd "$(dirname "$0")" && pwd -P)"
nav_command="${ZELLIJ_NAV_COMMAND:-$script_dir/zellij-nav}"
mode="${1:---all}"

if [ "$mode" = "--render-preview" ]; then
  shift
  exec "$nav_command" picker-preview "$@"
fi

if [ "$mode" = "--session-manager" ]; then
  exec "$nav_command" picker-command session-manager
fi

exec "$nav_command" picker-run "$mode" "$0"
